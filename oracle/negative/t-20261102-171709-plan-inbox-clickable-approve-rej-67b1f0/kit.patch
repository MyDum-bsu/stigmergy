+"""Negative control kit: a planinbox that trusts every token and allows replay."""
+
+import stigmergy.planinbox as planinbox
+
+
+def _mutant_handle(plan_id, action, *, token, spec_sha, secret, state, apply):
+    apply(action)
+    return 200, action
+
+
